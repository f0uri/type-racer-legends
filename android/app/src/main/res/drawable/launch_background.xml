<?xml version="1.0" encoding="utf-8"?>
<!-- The first thing a player sees: the game's own dark background with the neon emblem.
     A white flash between the launcher icon and the first Flutter frame reads as a cheap app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/trl_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
